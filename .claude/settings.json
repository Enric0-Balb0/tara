{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npx tsc --noEmit)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(pytest*)",
