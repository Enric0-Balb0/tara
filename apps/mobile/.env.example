# Indirizzo del backend per l'app. Il default (nel codice, src/config.ts) è il PC visto
# dall'emulatore Android, quindi con l'emulatore non serve nulla.
# Per un telefono vero sulla stessa rete Wi-Fi: copia questo file in .env.local, metti
# l'IP del PC e avvia il backend con `uv run uvicorn tara_api.main:app --host 0.0.0.0`.
# Dopo una modifica riavvia `npx expo start`: il valore entra nel bundle.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
