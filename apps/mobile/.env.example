# Indirizzo del backend per l'app. Il default (nel codice, src/config.ts) è il PC visto
# dall'emulatore Android, quindi con l'emulatore non serve nulla.
# Per un telefono vero sulla stessa rete Wi-Fi: copia questo file in .env.local, metti
# l'IP del PC e avvia il backend con `uv run uvicorn tara_api.main:app --host 0.0.0.0`.
# Dopo una modifica riavvia `npx expo start`: il valore entra nel bundle.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Supabase Auth (accesso con codice via email). URL e chiave publishable sono pubblici per
# costruzione: entrano nel bundle e i dati li protegge la sicurezza per riga. Mai una chiave
# sb_secret_ o service_role qui. Le build preview e production li prendono da eas.json;
# per `npx expo start` copiali in .env.local.
EXPO_PUBLIC_SUPABASE_URL=https://fbwlepzrrvtngvbyktiv.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_GoF02dpsjcYOff3Qn_jECQ_ZHQI_-xI
