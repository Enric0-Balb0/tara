# Copia in .env (ignorato da git) e inserisci le chiavi lì, mai in questo file.

# Modello AI della pipeline, nella forma provider:modello di Pydantic AI.
# Cambiare modello, anche passando a uno a pagamento, significa cambiare solo questa riga.
#   google:<modello>     Gemini via Google AI Studio; chiave in GOOGLE_API_KEY.
#                        Senza attivare la fatturazione Cloud resta sul piano gratuito.
#   ollama:<modello>     modello locale; indirizzo in OLLAMA_BASE_URL.
#   anthropic:<modello>  Claude; chiave in ANTHROPIC_API_KEY (a pagamento).
# Il modello sotto è quello scelto con la valutazione (data/eval): cambiarlo richiede di
# rilanciare `python -m tara_catalog.translate eval` e confrontare i risultati.
TARA_AI_MODEL=google:gemini-3.1-flash-lite
GOOGLE_API_KEY=

# Ollama sul portatile, oppure sul PC fisso con la GPU (IP della rete di casa):
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ANTHROPIC_API_KEY=

# Pausa minima tra due richieste, in secondi: 6 s sono circa 10 richieste al minuto,
# dentro i limiti del piano gratuito di Gemini. Con un modello locale si può mettere 0.
TARA_AI_MIN_INTERVAL_S=6
